# Copy to .env and fill in for real integrations. Everything works in
# mock mode with no values set at all.

# Defaults to local SQLite. To point at Postgres (e.g. Supabase) instead:
# DATABASE_URL=postgresql+pg8000://<user>:<password>@<host>:5432/<database>
# See backend/README.md's "Why pg8000, not psycopg2" before swapping drivers.
DATABASE_URL=sqlite:///./agrishield.db

# Browser origin(s) allowed to call the API (comma-separated). Set to the
# hosted webapp URL in prod, e.g. CORS_ORIGINS=https://agrishield.vercel.app.
# Empty = allow all (demo convenience only).
CORS_ORIGINS=

# cPanel shared hosting fallback: set AGRISHIELD_LITE=1 and install
# requirements-cpanel.txt instead of requirements.txt — runs the API
# without the ML routers (no pandas/scikit-learn/numpy/ai-edge-litert).
# Unset (or 0) = full API.
AGRISHIELD_LITE=

# Google Earth Engine — needed for SatelliteService to pull real Sentinel-2
# imagery instead of returning a mock zone grid (see app/services/satellite_service.py).
GEE_SERVICE_ACCOUNT_JSON=

# Africa's Talking — needed for MessagingService to actually send SMS/USSD/
# voice alerts instead of logging them (see app/services/messaging_service.py).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Anthropic — needed for the /chat "Ask AgriShield" assistant to answer in
# free text instead of just the keyword-router's suite suggestion (see
# app/services/ai_advice_service.py). Unset = chat still works, routing the
# farmer's question to the right suite, but skips the conversational reply.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
