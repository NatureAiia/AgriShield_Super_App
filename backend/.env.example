# Copy to .env and fill in for real integrations. Everything works in
# mock mode with no values set at all.

DATABASE_URL=sqlite:///./agrishield.db

# Google Earth Engine — needed for SatelliteService to pull real Sentinel-2
# imagery instead of returning a mock zone grid (see app/services/satellite_service.py).
GEE_SERVICE_ACCOUNT_JSON=

# Africa's Talking — needed for MessagingService to actually send SMS/USSD/
# voice alerts instead of logging them (see app/services/messaging_service.py).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
